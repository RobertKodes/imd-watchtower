# LOG_RANGE=5000
# INTERVAL_SECONDS=60
# ADMIT_WARN_MINUTES=10
# ADMIT_CRITICAL_MINUTES=30
# LAUNCH_ADMITTED_MINUTES=45
# JOB_STALE_MINUTES=120
# PORT=8787
# DATA_FILE=data/state.json

